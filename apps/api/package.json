{
  "name": "@coach/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:api": "vitest run --project api --passWithNoTests",
    "cli": "node -r @swc-node/register src/cli/main.ts",
    "cli:built": "node dist/cli/main.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@coach/admin-kit": "workspace:*",
    "@coach/agents": "workspace:*",
    "@coach/graph-kit": "workspace:*",
    "@coach/types": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "nest-commander": "^3.21.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
