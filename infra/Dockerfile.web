# Graph Coach web image (the design documents section 3).
# Build from the repository root:  docker build -f infra/Dockerfile.web -t graph-coach-web:<revision> .

ARG NODE_IMAGE=node:24-bookworm-slim

# ─── Build stage ────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS build
ENV CI=true
RUN corepack enable
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/admin-kit/package.json packages/admin-kit/package.json
COPY packages/graph-kit/package.json packages/graph-kit/package.json
COPY packages/agents/package.json packages/agents/package.json
RUN pnpm install --frozen-lockfile --filter "@coach/web..."

COPY tsconfig.base.json ./
COPY packages/types packages/types
COPY apps/web apps/web
RUN pnpm --filter "@coach/web^..." run build \
 && pnpm --filter @coach/web run build

# The server bundle imports its npm dependencies at run time, so the run stage needs a production
# node_modules; `deploy` produces one without dev dependencies.
RUN pnpm --filter @coach/web --prod deploy --legacy /out

# ─── Run stage ──────────────────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS run
ENV NODE_ENV=production
WORKDIR /app

# Only what `node scripts/start.mjs` needs: the built server output, the start scripts, production modules.
COPY --from=build --chown=node:node /out/package.json ./package.json
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/apps/web/scripts ./scripts
COPY --from=build --chown=node:node /repo/apps/web/dist ./dist

# No .env and no secret in the image: every value comes from the container environment.
USER node
EXPOSE 3000
CMD ["node", "scripts/start.mjs"]
