# Graph Coach — environment variables.
# Copy to .env (`make setup` does it) and edit. One file serves the API, the web app, and docker compose.
# Names and rules: the design documents §2 and the design documents (I12, K4).
# No real secret belongs in this file. Values marked "local only" must be replaced anywhere else.

# ─── API ──────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# error | warn | log | debug
LOG_LEVEL=log
# Port the API listens on
API_PORT=3001
# The only origin allowed by CORS: a URL origin, no path, never * (the web server also reads it: required when AUTH_MODE=cognito)
WEB_ORIGIN=http://localhost:3000
# false | loopback | comma-separated addresses or subnets trusted to set X-Forwarded-For (API and web server)
TRUST_PROXY=loopback
# FalkorDB host name
FALKORDB_HOST=localhost
# FalkorDB port (also the host port in docker compose)
FALKORDB_PORT=6379
# Optional FalkorDB user name
FALKORDB_USERNAME=
# Optional FalkorDB password (secret)
FALKORDB_PASSWORD=
# Graph name: [a-z][a-z0-9_]{0,31}, must not start with test_
GRAPH_NAME=coach
# Postgres connection URL, required (secret; this value is local only)
DATABASE_URL=postgres://coach:coach@localhost:5432/coach
# cognito | dev — dev gives the local sign-in picker and is refused when NODE_ENV=production
AUTH_MODE=dev
# Signs development sign-in tokens; at least 16 characters; required only when AUTH_MODE=dev (secret; local only)
JWT_SECRET=local-only-change-me-dev-signing-key
# Cognito settings, required when AUTH_MODE=cognito (COGNITO_CLIENT_ID is also read by the web server)
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Comma-separated addresses that become admin on first sign-in (never commit a real address)
BOOTSTRAP_ADMIN_EMAILS=
# Chat model provider: stub | openai | ollama
LLM_PROVIDER=stub
# Chat model name, required unless the provider is stub
LLM_MODEL=
# Base URL, required for ollama, optional for openai-compatible services
LLM_BASE_URL=
# API key, required for openai (secret)
LLM_API_KEY=
# Embedding provider: stub | openai | ollama
EMBEDDING_PROVIDER=stub
# Embedding model name, required unless the provider is stub
EMBEDDING_MODEL=
# Base URL, required for ollama, optional for openai-compatible services
EMBEDDING_BASE_URL=
# API key, required for openai (secret)
EMBEDDING_API_KEY=
# Embedding dimension 1–8192, required unless stub; must match the vector index
EMBEDDING_DIM=64
# true | false — only matters when NODE_ENV=production
ALLOW_STUB_PROVIDERS=false
# Seconds between looks for queued coverage requests (cover tasks); 0 turns the poller off; never runs when NODE_ENV=test
COVER_POLL_SECONDS=30
# Usage tracing (Langfuse, usage only): on only when all three are set; empty keeps it off
LANGFUSE_PUBLIC_KEY=
# Langfuse secret key (secret)
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# true allows prompt and response capture for local work on synthetic content; refused in production
LANGFUSE_CAPTURE_CONTENT=

# ─── Web ──────────────────────────────────────────────────────────────────────
# Port the web server listens on
WEB_PORT=3000
# Where the web server forwards API calls and the event stream
API_URL=http://localhost:3001/api
# Secure flag of the session cookie; must be true when hosted
COOKIE_SECURE=false
# Cognito hosted sign-in domain, required when AUTH_MODE=cognito (COGNITO_CLIENT_ID above serves the web too)
# SEED_DEMO_PASSWORD is deliberately absent: only 008's Cognito script reads it, never the API, CLI, or web.
COGNITO_DOMAIN=
# Encrypts the session cookie (secret; local only)
SESSION_SECRET=local-only-change-me-session-cookie-key

# ─── Compose ──────────────────────────────────────────────────────────────────
# Postgres container user
POSTGRES_USER=coach
# Postgres container password (local only)
POSTGRES_PASSWORD=coach
# Postgres database name
POSTGRES_DB=coach
# Host port of Postgres
POSTGRES_PORT=5432
# Host port of the FalkorDB browser UI (3000 is the web app's)
FALKORDB_UI_PORT=3002
