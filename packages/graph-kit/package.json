{
  "name": "@coach/graph-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "queries"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:graph": "vitest run --project graph --passWithNoTests"
  },
  "devDependencies": {
    "@coach/admin-kit": "workspace:*",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@coach/types": "workspace:*",
    "falkordb": "^6.8.0",
    "zod": "^3.25.76"
  }
}
